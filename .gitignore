# captures d'écran des tests : elles se régénèrent, elles n'ont rien à faire ici
shot_*.png

# sondes de brouillon du banc : elles vivent le temps d'un diagnostic et
# meurent avec lui — on ne verse pas un instrument de mesure jetable dans le
# dépôt, il n'a de sens que pour la panne du jour.
tests/_diag_*.cjs

# Dépendances locales des outils de conversion et du banc.
# LES DEUX FORMES, ET C'EST UNE PANNE PAYÉE. Un motif qui finit par une barre
# ne matche qu'un DOSSIER : `tests/node_modules` est parti dans le dépôt en
# v281 sous forme de LIEN SYMBOLIQUE vers son propre chemin absolu, et tout
# arbre de travail neuf recevait une boucle où le banc ne démarrait plus.
**/node_modules/
**/node_modules
